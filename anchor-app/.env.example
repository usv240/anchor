# Copy to .env.local and fill in. Never commit real values.

# Qloo hackathon API key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=

# Anthropic API key for the agent (Claude)
ANTHROPIC_API_KEY=

# Optional: Upstash Redis for the private Qloo cache, API keys and rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
